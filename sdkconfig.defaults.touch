# env:c5_touch only (Waveshare ESP32-C5-Touch-LCD-3.5), on top of
# sdkconfig.defaults and sdkconfig.defaults.esp32c5.

# 8 MB quad PSRAM: display buffers, LVGL, and Wi-Fi/BLE buffers where they can
# go, since the SDR's capture bank takes 128 KB of internal SRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# LVGL 9: RGB565 over SPI, its allocator in PSRAM (lapdog_touch/lv_mem_psram.c), and
# the Montserrat sizes the screens use.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_DEMO_WIDGETS=n

# Room below the SDR's capture bank: PSRAM support adds ~16 KB of IRAM, so the
# SPI master's ISR (the display) runs from flash.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_touch.csv"

# Skip the 8 MB PSRAM self-test at boot (about a second).
# CONFIG_SPIRAM_MEMTEST is not set

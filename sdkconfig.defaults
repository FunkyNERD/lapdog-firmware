# Console + config/lap output over the chip's built-in USB Serial/JTAG (C5 and C3) (shows up as CDC-ACM).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE advertising bursts (lap output) - NimBLE is the smaller host stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Legacy (31-byte) adverts via ble_gap_adv_*; see lap_frame.h for the size budget.
# CONFIG_BT_NIMBLE_EXT_ADV is not set

# ESP-NOW lap output to goggles/RacePanel.
CONFIG_ESP_WIFI_ENABLED=y

CONFIG_FREERTOS_HZ=1000

# Both boards have 4 MB flash. The app (Wi-Fi + NimBLE) is over the default
# single-app table's 1 MB slot - see partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
